{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.EranYonai/conning",
  "title": "Conning",
  "description": "Run commands on your remote test machines over SSH without the agent ever seeing a secret.",
  "repository": {
    "url": "https://github.com/EranYonai/Conning",
    "source": "github"
  },
  "websiteUrl": "https://github.com/EranYonai/Conning",
  "version": "0.6.3",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "conning",
      "version": "0.6.3",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    },
    {
      "registryType": "oci",
      "identifier": "ghcr.io/eranyonai/conning:0.6.3",
      "transport": {
        "type": "stdio"
      },
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--network",
          "value": "host"
        },
        {
          "type": "named",
          "name": "--volume",
          "value": "{conning_home}:/conning",
          "variables": {
            "conning_home": {
              "description": "Absolute path of Conning's config folder on your machine (usually ~/.config/conning, expanded)",
              "format": "filepath",
              "isRequired": true
            }
          }
        },
        {
          "type": "named",
          "name": "--volume",
          "value": "{ssh_auth_sock}:/ssh-agent",
          "variables": {
            "ssh_auth_sock": {
              "description": "Your ssh-agent socket ($SSH_AUTH_SOCK; /run/host-services/ssh-auth.sock on Docker Desktop for Mac)",
              "format": "filepath",
              "isRequired": true
            }
          }
        },
        {
          "type": "named",
          "name": "--env",
          "value": "SSH_AUTH_SOCK=/ssh-agent"
        }
      ]
    }
  ]
}
